<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <ImageView
        android:id="@+id/image_item"
        android:layout_width="150dp"
        android:layout_height="100dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/eldenringportada"/>

    <TextView
        android:id="@+id/text_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:text="Elden Ring"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/image_item"
        app:layout_constraintEnd_toStartOf="@id/image_delete" />

    <TextView
        android:id="@+id/text_price_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="precio:"
        android:textColor="#CCCCCC"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/text_item_name"
        app:layout_constraintTop_toBottomOf="@id/text_item_name" />

    <TextView
        android:id="@+id/text_item_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"

        android:text="$29.990"
        android:textColor="@android:color/white"
        android:background="@drawable/background_with_border" android:textSize="14sp"

        app:layout_constraintStart_toEndOf="@id/text_price_label"
        app:layout_constraintTop_toTopOf="@id/text_price_label"
        app:layout_constraintBottom_toBottomOf="@id/text_price_label"
        app:layout_constraintBaseline_toBaselineOf="@id/text_price_label" />

    <ImageButton
        android:id="@+id/image_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/outline_delete_24"
        app:layout_constraintBottom_toBottomOf="@id/image_item"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>