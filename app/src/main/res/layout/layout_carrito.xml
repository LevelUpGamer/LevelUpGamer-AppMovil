<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Contenido principal -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#2B0030">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"

            android:layout_width="match_parent"
            android:layout_height="99dp"
            android:background="#800060"
            android:contentInsetStart="0dp"
            android:contentInsetLeft="0dp"
            android:paddingTop="15dp">

            <!-- LinearLayout dentro del Toolbar para botones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Inicio"
                    android:src="@drawable/ic_menu" />

                <EditText
                    android:id="@+id/searchBar"
                    android:layout_width="322dp"
                    android:layout_height="40dp"
                    android:layout_weight="0.7"
                    android:background="@drawable/search_background"
                    android:hint="Buscar juegos..."
                    android:textColor="@android:color/black"
                    android:textColorHint="#999" />

                <ImageButton
                    android:id="@+id/btnCartHome"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/outline_add_shopping_cart_24" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="15dp">

            <TextView
                android:id="@+id/title_cart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tu carrito de compras            "
                android:textColor="@android:color/white"
                android:textSize="19sp"
                android:layout_gravity="center"/>
        </FrameLayout>

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_cart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Footer -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">


            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/text_total_label"
                    android:text="Total:"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/text_total_value"
                    android:text="$29.990"
                    android:textColor="#E91E63"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/button_checkout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Paga de forma segura"
                android:textColor="@android:color/white"
                android:backgroundTint="#E91E63"
                android:layout_marginTop="16dp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Menú lateral -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/menu_drawer"
        android:background="#800060"
        app:headerLayout="@layout/nav_header"
        app:itemTextColor="@android:color/white"
        app:itemIconTint="@android:color/white"/>
</androidx.drawerlayout.widget.DrawerLayout>
