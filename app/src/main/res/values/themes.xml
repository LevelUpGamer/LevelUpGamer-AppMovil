<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.LevelUpGamer.Splash" parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">@color/purple_dark</item>

        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_padded</item>

        <item name="windowSplashScreenAnimationDuration">1000</item>

        <item name="postSplashScreenTheme">@style/Theme.LevelUpGamer</item>

    </style>

    <style name="Theme.LevelUpGamer.actionbar" parent="Theme.AppCompat.Light.NoActionBar">

        <item name="colorPrimary">@color/purple_dark</item>
        <item name="colorOnPrimary">@color/white</item>

    </style>

    <style name="Theme.LevelUpGamer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Fondo por defecto (para evitar pantallazos blancos) -->
        <item name="android:windowBackground">#2B0030</item>
    </style>


</resources>